{
  "name": "firstword-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write src shared server tests *.ts *.json",
    "eval:roleplay": "tsx scripts/roleplay-eval.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "msedge-tts": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
